# Copy this file to `.env` before running `make up`.
# Never commit `.env`.

# --- Compose database bootstrap -------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_TO_A_LONG_RANDOM_STRING
POSTGRES_DB=convert_invert

# Used by the API container. The hostname must be `db` inside Docker Compose.
DATABASE_URL=postgresql://postgres:CHANGE_ME_TO_A_LONG_RANDOM_STRING@db:5432/convert_invert

# --- Auth -------------------------------------------------------------------
# People log in with Spotify; only invited emails (and ADMIN_EMAILS) get in.
# API_KEY is a service token for scripts and is never sent to the browser.
# Generate with: openssl rand -hex 32
API_KEY=CHANGE_ME_TO_A_LONG_RANDOM_STRING
ALLOWED_ORIGINS=http://localhost:5173
# Register this exact URL as a Redirect URI in the Spotify developer dashboard. Plain http
# is only accepted on a loopback IP (127.0.0.1, not localhost), so open the app at
# http://127.0.0.1:5173; from other machines it needs https.
SPOTIFY_REDIRECT_URI=http://127.0.0.1:5173/api/auth/callback
# Encrypts each user's Spotify tokens. Generate with: openssl rand -base64 32
# If you lose or change it, everyone just has to log in again.
TOKEN_ENC_KEY=CHANGE_ME_BASE64_32_BYTES
# Comma-separated emails that become admins on login (no invite needed).
ADMIN_EMAILS=you@example.com
# Session cookies are Secure by default. Set to false only for plain-HTTP local use
# (e.g. http://localhost:5173), never in production.
COOKIE_SECURE=false

# --- Soulseek --------------------------------------------------------------
USER_NAME=your-soulseek-username
USER_PASSWORD=your-soulseek-password
LISTEN_PORT=41000
SHARE_LISTEN_PORT=41032
SHARE_RESCAN_INTERVAL_SECS=60

# --- Spotify ---------------------------------------------------------------
CLIENT_ID=your-spotify-client-id
CLIENT_SECRET=your-spotify-client-secret

# --- Judge -----------------------------------------------------------------
# Which judge decides whether a Soulseek result is the requested recording.
#   levenshtein  string similarity (default; no extra services)
#   smol         the fine-tuned SmolLM judge served by ollama — it answers with
#                a label, so it can tell "Only Human" from "Only Human (Remix)",
#                which string distance cannot
# For `smol`, the ollama host must serve the model and listen on the docker
# bridge (OLLAMA_HOST=0.0.0.0 in the ollama service), then:
#   ollama pull eduardogonik/smol-judge:c200-q8
JUDGE_BACKEND=levenshtein
SMOL_JUDGE_URL=http://host.docker.internal:11434
SMOL_JUDGE_MODEL=eduardogonik/smol-judge:c200-q8
# The deterministic rule engine runs in front of the model and settles ~83% of
# candidates with no inference. Set to 0/false/off only to measure the model
# unaided — leaving it on is both cheaper and more accurate.
SMOL_JUDGE_RULES=true
# In-flight requests to ollama, per worker (so the real ceiling is this times
# WORKER_COUNT). Ollama serves one at a time per model, so more than a handful
# only adds queueing.
SMOL_JUDGE_CONCURRENCY=4
SMOL_JUDGE_TIMEOUT_SECS=30
# How long ollama keeps the model resident between candidates.
SMOL_JUDGE_KEEP_ALIVE=30m
# What happens when ollama is unreachable: `levenshtein` keeps the pipeline
# running at the old quality (the error is still recorded on the judgement),
# `reject` scores 0 so nothing is downloaded on a guess.
SMOL_JUDGE_FALLBACK=levenshtein

# --- Optional service ports / runtime -------------------------------------
API_PORT=3124
FRONTEND_PORT=5173
JAEGER_UI_PORT=16686
OTLP_GRPC_PORT=4317
REDIS_URL=redis://redis:6379
RUN_ID=compose
LOG_LEVEL=info
WORKER_ACCOUNT_MODE=same
SHARE_MODE=external
SHARE_PATH=/downloads
